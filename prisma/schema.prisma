// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  wheels    Wheel[]
  spins     Spin[]
}

enum Role {
  USER
  ADMIN
}

// Wheel types
enum WheelType {
  NAMES
  NUMBERS
  DECISIONS
  PRIZES
  FOOD
  CUSTOM
}

// Wheel model
model Wheel {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  type            WheelType @default(CUSTOM)
  maxSpins        Int?
  expiryDate      DateTime?
  allowBetterLuck Boolean   @default(true)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items           WheelItem[]
  spins           Spin[]
}

// Wheel items (segments)
model WheelItem {
  id      String  @id @default(cuid())
  label   String
  value   String?
  order   Int     @default(0)
  
  wheelId String
  wheel   Wheel   @relation(fields: [wheelId], references: [id], onDelete: Cascade)
}

// Spin results
model Spin {
  id           String   @id @default(cuid())
  participantName  String
  participantPhone String?
  result       String
  createdAt    DateTime @default(now())
  
  wheelId      String
  wheel        Wheel    @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
}
