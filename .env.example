# MongoDB Database (MongoDB Atlas)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/spinwheel?appName=Cluster0"

# JWT Secret (generate a random 32+ character string)
JWT_SECRET="your-secret-key-here"

# Comma-separated origins allowed to call API routes cross-origin
# Example: CORS_ALLOWED_ORIGINS="https://your-app.vercel.app,https://www.yourdomain.com"
CORS_ALLOWED_ORIGINS=""

# Longcat AI integration (OpenAI-compatible endpoint)
LONGCAT_API_KEY=""
LONGCAT_OPENAI_BASE="https://api.longcat.chat/openai"
LONGCAT_MODEL="LongCat-Flash-Chat"

# Daily shared quota across all users (tokens)
LONGCAT_DAILY_TOKEN_LIMIT="100000"

# Admin credentials for seeding (npm run db:seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-password"
